rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "o9ubSreUTYZIIH7dgp4irM2MNyf2";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
